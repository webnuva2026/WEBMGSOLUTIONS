{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "▶️ Iniciar Todo (Backend + Frontend)",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm start",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "⚙️ Iniciar Solo Backend (Express :4000)",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run server:dev",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "🌐 Iniciar Solo Frontend (Vite :3000)",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run dev",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "🧹 Limpiar Puertos (3000 y 4000)",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run clean:ports",
      "cwd": "${workspaceFolder}"
    }
  ]
}